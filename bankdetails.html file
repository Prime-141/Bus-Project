<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Secure Payment</title>
  <style>
    :root {
      --primary: #4361ee;
      --secondary: #3a0ca3;
      --accent: #f72585;
      --light: #f8f9fa;
      --dark: #212529;
      --success: #4cc9f0;
      --error: #ef233c;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2rem;
      color: var(--dark);
    }

    .container {
      max-width: 480px;
      margin: 0 auto;
      width: 100%;
    }

    .payment-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .payment-header h2 {
      color: var(--secondary);
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      position: relative;
      display: inline-block;
    }

    .payment-header h2::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 3px;
      background: var(--accent);
      border-radius: 3px;
    }

    .payment-header p {
      color: #6c757d;
      font-size: 0.9rem;
    }

    .payment-card {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      transition: transform 0.3s ease;
    }

    .payment-card:hover {
      transform: translateY(-5px);
    }

    .form-group {
      margin-bottom: 1.5rem;
      position: relative;
    }

    label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 600;
      color: var(--dark);
      font-size: 0.9rem;
    }

    input {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid #ced4da;
      border-radius: 8px;
      font-size: 1rem;
      transition: all 0.3s;
    }

    input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.2);
    }

    input::placeholder {
      color: #adb5bd;
      opacity: 1;
    }

    .card-icons {
      position: absolute;
      right: 12px;
      top: 35px;
      display: flex;
      gap: 8px;
    }

    .card-icons img {
      height: 24px;
      opacity: 0.6;
      transition: opacity 0.3s;
    }

    .card-icons img:hover {
      opacity: 1;
    }

    .form-row {
      display: flex;
      gap: 1rem;
    }

    .form-row .form-group {
      flex: 1;
    }

    .error {
      color: var(--error);
      font-size: 0.8rem;
      margin-top: 0.25rem;
      display: block;
      min-height: 1rem;
    }

    .btn {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .btn:hover {
      background: linear-gradient(135deg, var(--secondary), var(--primary));
      box-shadow: 0 5px 15px rgba(58, 12, 163, 0.3);
      transform: translateY(-2px);
    }

    .btn:active {
      transform: translateY(0);
    }

    .secure-payment {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 1.5rem;
      color: #6c757d;
      font-size: 0.8rem;
    }

    .secure-payment svg {
      fill: var(--success);
    }

    @media (max-width: 480px) {
      body {
        padding: 1rem;
      }
      
      .payment-card {
        padding: 1.5rem;
      }
      
      .form-row {
        flex-direction: column;
        gap: 0;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="payment-header">
      <h2>Secure Payment</h2>
      <p>Complete your booking with confidence</p>
    </div>

    <div class="payment-card">
      <form id="paymentForm" action="payment" method="post" novalidate>
        <!-- Hidden fields -->
        <input type="hidden" name="busno" value="${busNo}" />
        <input type="hidden" name="pname" value="${passengerName}" />
        <input type="hidden" name="age" value="${age}" />
        <input type="hidden" name="seats" value="${seats}" />
        <input type="hidden" name="bustype" value="${busType}" />
        <input type="hidden" name="start" value="${start}" />
        <input type="hidden" name="end" value="${end}" />
        <input type="hidden" name="date" value="${date}" />
        <input type="hidden" name="time" value="${time}" />
        <input type="hidden" name="fare" value="${fare}" />

        <!-- Card Number -->
        <div class="form-group">
          <label for="card">Card Number</label>
          <input 
            type="text" 
            id="card" 
            name="cardno" 
            maxlength="16" 
            placeholder="1234 5678 9012 3456" 
            required 
            inputmode="numeric"
            pattern="[0-9\s]{13,19}"
          />
          <div class="card-icons">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/visa/visa-original.svg" alt="Visa">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mastercard/mastercard-original.svg" alt="Mastercard">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apple/apple-original.svg" alt="Apple Pay">
          </div>
          <span class="error" id="cardError"></span>
        </div>

        <div class="form-row">
          <!-- Expiration Date -->
          <div class="form-group">
            <label for="expiry">Expiry Date</label>
            <input 
              type="text" 
              id="expiry" 
              name="expiry" 
              placeholder="MM/YY" 
              required 
              maxlength="5"
            />
            <span class="error" id="expiryError"></span>
          </div>

          <!-- CVV -->
          <div class="form-group">
            <label for="cvv">CVV</label>
            <input 
              type="password" 
              id="cvv" 
              name="cvv" 
              maxlength="4" 
              placeholder="123" 
              required 
              inputmode="numeric"
            />
            <span class="error" id="cvvError"></span>
          </div>
        </div>

        <!-- Cardholder Name -->
        <div class="form-group">
          <label for="cardname">Cardholder Name</label>
          <input 
            type="text" 
            id="cardname" 
            name="cardname" 
            placeholder="John Doe" 
            required 
          />
          <span class="error" id="nameError"></span>
        </div>

        <button type="submit" class="btn">Pay ₹${fare}</button>

        <div class="secure-payment">
          <svg width="16" height="16" viewBox="0 0 24 24">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11V11.99z"/>
          </svg>
          <span>Secure SSL encrypted payment</span>
        </div>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('paymentForm');
    const card = document.getElementById('card');
    const expiry = document.getElementById('expiry');
    const cvv = document.getElementById('cvv');
    const name = document.getElementById('cardname');

    const cardError = document.getElementById('cardError');
    const expiryError = document.getElementById('expiryError');
    const cvvError = document.getElementById('cvvError');
    const nameError = document.getElementById('nameError');

    // Format card number with spaces
    card.addEventListener('input', function(e) {
      let value = e.target.value.replace(/\s+/g, '');
      if (value.length > 0) {
        value = value.match(new RegExp('.{1,4}', 'g')).join(' ');
      }
      e.target.value = value;
    });

    // Format expiry date
    expiry.addEventListener('input', function(e) {
      let value = e.target.value.replace(/\D/g, '');
      if (value.length >= 2) {
        value = value.substring(0, 2) + '/' + value.substring(2, 4);
      }
      e.target.value = value;
    });

    form.addEventListener('submit', function(e) {
      let isValid = true;
      
      // Clear previous errors
      [cardError, expiryError, cvvError, nameError].forEach(el => el.textContent = '');

      // Validate card number (13-16 digits)
      const cardValue = card.value.replace(/\s+/g, '');
      if (!/^\d{13,16}$/.test(cardValue)) {
        cardError.textContent = 'Please enter a valid 13-16 digit card number';
        isValid = false;
      }

      // Validate expiry date (MM/YY format)
      if (!/^(0[1-9]|1[0-2])\/?([0-9]{2})$/.test(expiry.value)) {
        expiryError.textContent = 'Please enter a valid expiry date (MM/YY)';
        isValid = false;
      }

      // Validate CVV (3-4 digits)
      if (!/^\d{3,4}$/.test(cvv.value)) {
        cvvError.textContent = 'CVV must be 3 or 4 digits';
        isValid = false;
      }

      // Validate cardholder name (min 2 chars)
      if (name.value.trim().length < 2) {
        nameError.textContent = 'Please enter the cardholder name';
        isValid = false;
      }

      if (!isValid) {
        e.preventDefault();
        // Add shake animation to errors
        document.querySelectorAll('.error:not(:empty)').forEach(el => {
          el.parentElement.classList.add('error-shake');
          setTimeout(() => el.parentElement.classList.remove('error-shake'), 500);
        });
      }
    });
  </script>
</body>
</html>
