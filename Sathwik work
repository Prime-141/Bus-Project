//javax is pacakage name

import java.io.IOException;  //IO Exception 
import javax.servlet.ServletException; // This is exception for handling errors in Servlet
import javax.servlet.annotation.WebServlet; // This is for using annotaion @WebServlet
import javax.servlet.http.HttpServlet; // this is the base class for creating the servlet 
import javax.servlet.http.HttpServletRequest; // for typing that request.getParameter()
import javax.servlet.http.HttpServletResponse; //response.getWrtiter()
import javax.servlet.http.HttpSession;// whenever user login here the data of name and password stores so that can be used any time (RAM).

import java.util.*;

@WebServlet("/login")
public class LoginServlet extends HttpServlet {
	private static final long serialVersionUID = 1L;
       
    
    
    // init() Initailising method
    @Override
    public void init() throws ServletException{  // making list of users which include username and admin
    	ArrayList<User> users = new ArrayList<>();
    	users.add(new User("admin1","1470"));
    	users.add(new User("admin2","9630"));
    	getServletContext().setAttribute("users", users); // Share the list
    	//getServletContext() se ServletContext object milta hai, jo application ke scope me hota hai.
    	//setAttribute("users", users) se ye list poori application (sab servlets aur JSPs) ke liye share kar di jaati hai.
    	//list sab jagah accessible hoti hai jab tak application chal raha hai.
    }

	
	protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		// Ek simple message likha browser me — mostly testing/debugging ke liye
		response.getWriter().append("Served at: ").append(request.getContextPath());
	}
	//So basically, response.getWriter() se hum client ko output dene ke liye ek writer le rahe hain.
    // we have Do get method why as if we run the servlet from login.html after that browser will send by default a get request but that request
	// will not handle as doGet method is not here and show erro 405
	
	
	
	protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		
		
		//Getting username and password from the form by the name =" " value
		String username = request.getParameter("username");  
		String password = request.getParameter("password");
		
		@SuppressWarnings("unchecked") //No warnings 
		ArrayList<User> users = (ArrayList<User>) getServletContext().getAttribute("users");
		for (User user : users) {
			if(user.checkCredentials(username, password)) {
				// Redirect to Bus List page after successful login
				
				
				//Session created  it will store the username for every page after the login procedure
				HttpSession session = request.getSession();
				session.setAttribute("username", username);// Session me username store kiya
				session.setAttribute("password",password);//  Session me password store kiya
				
				//Login succesful
				response.sendRedirect(request.getContextPath() + "/buslist.html");

				return;
			}
		}
		
		// Wrong credentials
		response.sendRedirect("login.html? error");
	}

}

