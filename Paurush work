        out.println("<input type='hidden' name='bustype' value='" + busType + "'>");
        out.println("<input type='hidden' name='start' value='" + start + "'>");
        out.println("<input type='hidden' name='end' value='" + end + "'>");
        out.println("<input type='hidden' name='date' value='" + date + "'>");
        out.println("<input type='hidden' name='time' value='" + time + "'>");
        out.println("<input type='hidden' name='fare' value='" + fare+"'>");
        out.println("    <label for=\"card\">Card Number</label>");
        out.println("    <input type=\"text\" id=\"card\" name=\"cardno\" placeholder=\"1234 5678 9012 3456\"");
        out.println("           oninput=\"formatCardNumber(this)\" required>");
        out.println("    <div class=\"row\">");
        out.println("      <div class=\"col\">");
        out.println("        <label for=\"cvv\">CVV</label>");
        out.println("        <input type=\"password\" id=\"cvv\" name=\"cvv\"");
        out.println("               pattern=\"\\d{4}\" inputmode=\"numeric\"");
        out.println("               placeholder=\"CVV\" maxlength=\"4\" required>");
        out.println("      </div>");
        out.println("      <div class=\"col\">");
        out.println("        <label for=\"expiry\">Expiry Date</label>");
        out.println("        <input type=\"month\" id=\"expiry\" name=\"expiry\" required>");
        out.println("      </div>");
        out.println("    </div>");
        out.println("    <label for=\"cardname\">Name on Card</label>");
        out.println("    <input type=\"text\" id=\"cardname\" name=\"cardname\" placeholder=\"John Doe\" required>");
        out.println("    <button type=\"submit\">Pay Now</button>");
        out.println("  </form>");
        out.println("<script>");
        out.println("  function formatCardNumber(input) {");
        out.println("    let value = input.value.replace(/\\D/g, '').substring(0,16); // Allow digits only, max 16");
        out.println("    let formatted = value.match(/.{1,4}/g)?.join(' ') || '';");
        out.println("    input.value = formatted;");
        out.println("  }");
        out.println("</script>");
        out.println("</body>");
        out.println("</html>");

	}

}

